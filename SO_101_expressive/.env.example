# klucz z google ai studio - wpisz go tylko w lokalnym pliku .env, który nie trafia do repozytorium
GEMINI_API_KEY=

# model rozmowy głosowej na żywo zgodny z cennikiem i dokumentacją z września 2026
LIVE_MODEL=gemini-3.8-live

# głos syntezy odpowiedzi modelu; wszystkie głosy mówią po polsku, zmień dla innej barwy
VOICE_NAME=Puck

# twardy limit kosztu jednej sesji w złotych; po jego przekroczeniu wywołania API są wyłączane
BUDGET_SESSION_PLN=5.0

# twardy limit łącznych wydatków ze wszystkich sesji zapisany w runtime/usage_ledger.json
BUDGET_TOTAL_PLN=130.0

# ułamek limitu, od którego panel pokazuje ostrzeżenie
BUDGET_WARN_FRACTION=0.8

# kurs przeliczenia dolarów na złote do szacunku kosztów - zaktualizuj według bieżącego kursu
USD_TO_PLN=3.65

# mnożnik bezpieczeństwa szacunku, bo rachunek google może się różnić od lokalnych obliczeń
COST_SAFETY_FACTOR=1.25

# próg kompresji okna kontekstu - niższy obniża koszt każdej tury kosztem krótszej pamięci rozmowy
CONTEXT_TRIGGER_TOKENS=12000

# liczba tokenów zostawianych po kompresji okna kontekstu
CONTEXT_TARGET_TOKENS=4000

# rozłączenie sesji po tylu sekundach bez rozmowy i bez osoby w kadrze, żeby nie płacić za nasłuch
IDLE_DISCONNECT_S=90

# vad wysyła do chmury tylko fragmenty z mową; continuous wysyła cały strumień i kosztuje więcej
MIC_STREAM_MODE=vad

# half_duplex bramkuje mikrofon w czasie mowy robota z głośników; off tylko przy słuchawkach
ECHO_MODE=half_duplex

# ile razy głośniej od echa trzeba mówić, żeby przerwać robota wchodząc mu w słowo
BARGE_IN_RATIO=3.0

# gdy tak, robot milknie przez cały czas trzymania obiektu; chwytak i tak nie rusza się w rytm mowy
MUTE_SPEECH_WHILE_HOLDING=nie

# co ile sekund cyklicznie wysyłać małą klatkę kamery do chmury; 0 oznacza wysyłanie tylko na prośbę modelu, np. gdy zapytasz co robot widzi
VISION_UPLINK_INTERVAL_S=0

# on_request wysyła jedną klatkę tylko po twojej rozpoznanej prośbie, np. co widzisz albo spójrz; off całkowicie wyłącza wysyłanie obrazu
CAMERA_CLOUD=on_request

# ile sekund po rozpoznanej prośbie rozmówcy o spojrzenie można jeszcze wysłać jedną klatkę z kamery
CAMERA_REQUEST_WINDOW_S=20

# numer kamery w systemie; wbudowana kamera macbooka to zwykle 0
CAMERA_INDEX=0

# przybliżony poziomy kąt widzenia kamery laptopa używany do kierowania wzroku robota
CAMERA_HFOV_DEG=70

# globalne spowolnienie ruchów od 0.1 do 1.0, przydatne przy pierwszych próbach
SPEED_SCALE=1.0

# ścieżka do pliku mjcf so-101; można wskazać model z projektu so_101_arm bez jego modyfikowania
MJCF_PATH=assets/so101/so101.xml

# wyprzedzenie szczęki względem dźwięku; skalibrowane w symulacji, dla prawdziwych serw do ponownego pomiaru
JAW_LEAD_S=0.11

# po ilu sekundach nieobecności rozmówcy wrócić powoli do pozycji neutralnej; 0 oznacza brak ruchu
PERSON_RETURN_TO_NEUTRAL_S=0

# polski głos systemowy macos używany w trybie lokalnym bez klucza api
OFFLINE_TTS_VOICE=Zosia
